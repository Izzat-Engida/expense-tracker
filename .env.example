# Google OAuth 2.0 Credentials
# Create these in Google Cloud Console -> APIs & Services -> Credentials
# Enable "Google Drive API" and add scope: "https://www.googleapis.com/auth/drive.appdata"

# Web Client ID (used for web or general Expo development)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# iOS Client ID (Bundle ID: your configured app scheme)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Android Client ID (Package name + SHA-1 fingerprint)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
